<?xml version="1.0" encoding="UTF-8"?>
<idea-plugin>
    <id>com.chu7.vuekit</id>
    <name>VueKit</name>
    <version>1.0.1</version>
    <vendor email="luyanan0718@163.com" url="https://github.com/rainsoil/vuekit">luyanan</vendor>

    <description><![CDATA[
        VueKit (Vue Development Toolkit)</h3>
        <p>A comprehensive IntelliJ IDEA plugin for Vue.js developers, providing intelligent component completion, documentation, and advanced development assistance features.</p>
        <h4>Main Features:</h4>
        <ul>
            <li><b>Smart Component Completion</b> - Supports major UI component libraries including Element Plus, Element UI, and Ant Design Vue</li>
            <li><b>Intelligent Property Suggestions</b> - Provides smart suggestions for attributes, events, and slots based on component type</li>
            <li><b>Real-time Documentation Display</b> - Displays detailed component documentation and usage examples on hover or selection</li>
            <li><b>Multi-library Support</b> - Automatically detects component libraries used in projects, supports manual configuration</li>
            <li><b>Custom Component Libraries</b> - Supports importing and managing custom component libraries</li>
            <li><b>Right-click Documentation</b> - Quickly access detailed component/attribute/event documentation via right-click menu</li>
            <li><b>Remote Component Library Management</b> - Download and manage component libraries from official marketplace</li>
        </ul>

        <h4>Supported Component Libraries:</h4>
        <ul>
            <li>Element Plus (Latest Version)</li>
            <li>Element UI (Classic Version)</li>
            <li>Ant Design Vue</li>
            <li>Custom Component Libraries</li>
            <li>Remote Component Libraries</li>
        </ul>

        <h4>Use Cases:</h4>
        <ul>
            <li>Vue.js project development</li>
            <li>Component library documentation lookup</li>
            <li>Code completion and suggestions</li>
            <li>Development efficiency enhancement</li>
            <li>Remote component library management</li>
        </ul>
    ]]></description>


    <idea-version since-build="231.0" until-build="251.*"/>
    
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.xml</depends>
    <depends>JavaScript</depends>
    <depends>org.jetbrains.plugins.vue</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 启动活动 -->
        <postStartupActivity implementation="com.chu7.vuecomponentassistant.startup.UnifiedPluginStartupActivity"/>
        
        <!-- B1: 组件标签补全扩展点 -->
        <xml.tagNameProvider implementation="com.chu7.vuecomponentassistant.extension.UnifiedTagNameProvider" order="first"/>
        <xml.elementDescriptorProvider implementation="com.chu7.vuecomponentassistant.extension.UnifiedTagNameProvider" order="first"/>
        
        <!-- B2: 属性名称补全扩展点 -->
        <xml.tagNameProvider implementation="com.chu7.vuecomponentassistant.extension.UnifiedXmlAttributeNameProvider" order="first"/>
        <!-- B2+: 属性名称 CompletionContributor（拦截并 stopHere） -->
        <completion.contributor language="XML" implementationClass="com.chu7.vuecomponentassistant.extension.UnifiedAttributeNameCompletionContributor" order="first"/>
        <completion.contributor language="HTML" implementationClass="com.chu7.vuecomponentassistant.extension.UnifiedAttributeNameCompletionContributor" order="first"/>
        <completion.contributor language="Vue" implementationClass="com.chu7.vuecomponentassistant.extension.UnifiedAttributeNameCompletionContributor" order="first"/>
        
        <!-- B2: 属性补全扩展点 -->
        <xml.attributeDescriptorsProvider implementation="com.chu7.vuecomponentassistant.extension.UnifiedXmlAttributeDescriptorsProvider" order="first"/>
        
        <!-- B2: 属性值补全扩展点 -->
        <completion.contributor language="XML" implementationClass="com.chu7.vuecomponentassistant.extension.UnifiedXmlAttributeValueProvider" order="first"/>
        <completion.contributor language="HTML" implementationClass="com.chu7.vuecomponentassistant.extension.UnifiedXmlAttributeValueProvider" order="first"/>
        <completion.contributor language="Vue" implementationClass="com.chu7.vuecomponentassistant.extension.UnifiedXmlAttributeValueProvider" order="first"/>
        
        <!-- B2: 文档提供者扩展点 -->
        <lang.documentationProvider language="XML" implementationClass="com.chu7.vuecomponentassistant.extension.UnifiedXmlDocumentationProvider"/>
        <lang.documentationProvider language="HTML" implementationClass="com.chu7.vuecomponentassistant.extension.UnifiedXmlDocumentationProvider"/>
        <lang.documentationProvider language="Vue" implementationClass="com.chu7.vuecomponentassistant.extension.UnifiedXmlDocumentationProvider"/>

		<!-- B4: 插槽补全扩展点 -->
		<completion.contributor language="XML" implementationClass="com.chu7.vuecomponentassistant.extension.UnifiedSlotCompletionContributor" order="first"/>
		<completion.contributor language="HTML" implementationClass="com.chu7.vuecomponentassistant.extension.UnifiedSlotCompletionContributor" order="first"/>
		<completion.contributor language="Vue" implementationClass="com.chu7.vuecomponentassistant.extension.UnifiedSlotCompletionContributor" order="first"/>

		<!-- Completion weigher to boost our items -->
		<completion.weigher id="vuekit.weigher" implementationClass="com.chu7.vuecomponentassistant.extension.UnifiedCompletionWeigher" key="priority" order="first"/>

        <projectConfigurable instance="com.chu7.vuecomponentassistant.settings.VueKitProjectSettingsConfigurable" id="VueKitProject" displayName="Vue Kit" parentId="tools"/>
        <notification.group id="VueKit" displayType="BALLOON" isLogByDefault="true"/>
    </extensions>
    
    <actions>
        <!-- 调试Action -->
        <action id="ComponentDebugAction" 
                class="com.chu7.vuecomponentassistant.debug.ComponentDebugAction" 
                text="Debug Component Provider" 
                description="Debug component provider status">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="AttributeDebugAction" 
                class="com.chu7.vuecomponentassistant.debug.AttributeDebugAction" 
                text="Debug Attribute Completion" 
                description="Debug attribute completion status">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="AttributeCompletionDebugAction" 
                class="com.chu7.vuecomponentassistant.debug.AttributeCompletionDebugAction" 
                text="Debug Attribute Completion Enhanced" 
                description="Debug enhanced attribute completion status">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="AttributeValueDebugAction" 
                class="com.chu7.vuecomponentassistant.debug.AttributeValueDebugAction" 
                text="Debug Attribute Value Completion" 
                description="Debug attribute value completion status">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="CompletionProviderDebugAction" 
                class="com.chu7.vuecomponentassistant.debug.CompletionProviderDebugAction" 
                text="Debug Completion Provider" 
                description="Debug completion provider registration">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="VueKit.ShowComponentDocumentationAction"
                class="com.chu7.vuecomponentassistant.action.ShowComponentDocumentationAction"
                text="显示组件文档"
                description="显示当前组件的完整文档">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
