{
  "id": "my-component-library",
  "name": "my-component-library",
  "componentPrefix": "my-",
  "displayName": "我的组件库",
  "description": "这是一个自定义组件库示例，包含常用的UI组件",
  "version": "1.0.0",
  "sourceUrl": "",
  "lastUpdated": "2025-08-11T10:00:09.914799",
  "_comment": "注意：source 字段会由程序根据导入方式自动设置，无需手动填写",
  "components": [
    {
      "name": "my-button",
      "description": "常用的按钮组件，支持多种样式和事件。",
      "version": "1.0.0",
      "example": "<my-button type=\"primary\">主要按钮</my-button>",
      "docUrl": "https://example.com/docs/my-button",
      "props": [
        {
          "name": "type",
          "type": "string",
          "description": "按钮类型",
          "defaultValue": "default",
          "required": false,
          "options": [
            "primary",
            "success",
            "warning",
            "danger",
            "info",
            "default"
          ]
        },
        {
          "name": "size",
          "type": "string",
          "description": "按钮尺寸",
          "defaultValue": "default",
          "required": false,
          "options": [
            "large",
            "default",
            "small"
          ]
        },
        {
          "name": "disabled",
          "type": "boolean",
          "description": "是否禁用按钮",
          "defaultValue": "false",
          "required": false
        },
        {
          "name": "loading",
          "type": "boolean",
          "description": "是否显示加载状态",
          "defaultValue": "false",
          "required": false
        }
      ],
      "events": [
        {
          "name": "click",
          "description": "点击按钮时触发",
          "parameters": "event"
        }
      ],
      "slots": [
        {
          "name": "default",
          "description": "按钮内容"
        },
        {
          "name": "icon",
          "description": "按钮图标"
        }
      ]
    },
    {
      "name": "my-input",
      "description": "输入框组件，支持多种类型和校验。",
      "version": "1.0.0",
      "example": "<my-input v-model=\"input\"></my-input>",
      "docUrl": "https://example.com/docs/my-input",
      "props": [
        {
          "name": "modelValue",
          "type": "string",
          "description": "绑定值",
          "defaultValue": "",
          "required": false
        },
        {
          "name": "type",
          "type": "string",
          "description": "输入框类型",
          "defaultValue": "text",
          "required": false,
          "options": [
            "text",
            "textarea",
            "password",
            "number",
            "email",
            "url",
            "tel"
          ]
        },
        {
          "name": "placeholder",
          "type": "string",
          "description": "占位符",
          "defaultValue": "",
          "required": false
        },
        {
          "name": "disabled",
          "type": "boolean",
          "description": "是否禁用",
          "defaultValue": "false",
          "required": false
        },
        {
          "name": "clearable",
          "type": "boolean",
          "description": "是否可清空",
          "defaultValue": "false",
          "required": false
        },
        {
          "name": "size",
          "type": "string",
          "description": "输入框尺寸",
          "defaultValue": "default",
          "required": false,
          "options": [
            "large",
            "default",
            "small"
          ]
        }
      ],
      "events": [
        {
          "name": "input",
          "description": "输入事件",
          "parameters": "value"
        },
        {
          "name": "change",
          "description": "值改变事件",
          "parameters": "value"
        },
        {
          "name": "clear",
          "description": "清空事件",
          "parameters": ""
        },
        {
          "name": "focus",
          "description": "获得焦点事件",
          "parameters": "event"
        },
        {
          "name": "blur",
          "description": "失去焦点事件",
          "parameters": "event"
        }
      ],
      "slots": [
        {
          "name": "prefix",
          "description": "输入框头部内容"
        },
        {
          "name": "suffix",
          "description": "输入框尾部内容"
        },
        {
          "name": "prepend",
          "description": "输入框前置内容"
        },
        {
          "name": "append",
          "description": "输入框后置内容"
        }
      ]
    }
  ]
} 