[
  {
    "name": "el-button",
    "description": "常用的按钮组件，支持多种样式和事件。",
    "version": "Element UI >=2.0.0",
    "example": "<el-button type=\"primary\">主要按钮</el-button>",
    "docUrl": "https://element.eleme.io/#/zh-CN/component/button",
    "props": [
      {
        "name": "type",
        "type": "string",
        "description": "按钮类型",
        "defaultValue": "default",
        "required": false,
        "options": ["primary", "success", "warning", "danger", "info", "text"]
      },
      {
        "name": "size",
        "type": "string",
        "description": "按钮尺寸",
        "defaultValue": "medium",
        "required": false,
        "options": ["medium", "small", "mini"]
      },
      {
        "name": "disabled",
        "type": "boolean",
        "description": "是否禁用按钮",
        "defaultValue": "false",
        "required": false
      },
      {
        "name": "loading",
        "type": "boolean",
        "description": "是否显示加载状态",
        "defaultValue": "false",
        "required": false
      }
    ],
    "events": [
      {
        "name": "click",
        "description": "点击按钮时触发",
        "parameters": "event"
      }
    ],
    "slots": [
      {
        "name": "default",
        "description": "按钮内容"
      }
    ]
  },
  {
    "name": "el-input",
    "description": "输入框组件，支持多种类型和校验。",
    "version": "Element UI >=2.0.0",
    "example": "<el-input v-model=\"input\"></el-input>",
    "docUrl": "https://element.eleme.io/#/zh-CN/component/input",
    "props": [
      {
        "name": "value",
        "type": "string",
        "description": "绑定值",
        "defaultValue": "",
        "required": false
      },
      {
        "name": "type",
        "type": "string",
        "description": "输入框类型",
        "defaultValue": "text",
        "required": false,
        "options": ["text", "textarea", "password", "number", "email", "url", "tel"]
      },
      {
        "name": "placeholder",
        "type": "string",
        "description": "占位符",
        "defaultValue": "",
        "required": false
      },
      {
        "name": "disabled",
        "type": "boolean",
        "description": "是否禁用",
        "defaultValue": "false",
        "required": false
      },
      {
        "name": "clearable",
        "type": "boolean",
        "description": "是否可清空",
        "defaultValue": "false",
        "required": false
      }
    ],
    "events": [
      {
        "name": "input",
        "description": "在输入值改变时触发",
        "parameters": "value"
      },
      {
        "name": "change",
        "description": "在值改变时触发",
        "parameters": "value"
      },
      {
        "name": "blur",
        "description": "在 Input 失去焦点时触发",
        "parameters": "event"
      },
      {
        "name": "focus",
        "description": "在 Input 获得焦点时触发",
        "parameters": "event"
      }
    ],
    "slots": [
      {
        "name": "default",
        "description": "输入框内容"
      },
      {
        "name": "prepend",
        "description": "输入框头部内容"
      },
      {
        "name": "append",
        "description": "输入框尾部内容"
      }
    ]
  },
  {
    "name": "el-table",
    "description": "表格组件，支持排序、筛选、分页等功能。",
    "version": "Element UI >=2.0.0",
    "example": "<el-table :data=\"tableData\"></el-table>",
    "docUrl": "https://element.eleme.io/#/zh-CN/component/table",
    "props": [
      {
        "name": "data",
        "type": "array",
        "description": "显示的数据",
        "defaultValue": "[]",
        "required": false
      },
      {
        "name": "height",
        "type": "string|number",
        "description": "Table 的高度",
        "defaultValue": "",
        "required": false
      },
      {
        "name": "max-height",
        "type": "string|number",
        "description": "Table 的最大高度",
        "defaultValue": "",
        "required": false
      },
      {
        "name": "stripe",
        "type": "boolean",
        "description": "是否为斑马纹 table",
        "defaultValue": "false",
        "required": false
      },
      {
        "name": "border",
        "type": "boolean",
        "description": "是否带有纵向边框",
        "defaultValue": "false",
        "required": false
      },
      {
        "name": "size",
        "type": "string",
        "description": "Table 的尺寸",
        "defaultValue": "medium",
        "required": false,
        "options": ["medium", "small", "mini"]
      }
    ],
    "events": [
      {
        "name": "select",
        "description": "当用户手动勾选数据行的 Checkbox 时触发的事件",
        "parameters": "selection, row"
      },
      {
        "name": "select-all",
        "description": "当用户手动勾选全选 Checkbox 时触发的事件",
        "parameters": "selection"
      },
      {
        "name": "selection-change",
        "description": "当选择项发生变化时会触发该事件",
        "parameters": "selection"
      }
    ],
    "slots": [
      {
        "name": "default",
        "description": "表格内容"
      },
      {
        "name": "append",
        "description": "插入至表格最后一行之后的内容"
      }
    ]
  },
  {
    "name": "el-form",
    "description": "表单容器组件，配合 el-form-item 使用。",
    "version": "Element UI >=2.0.0",
    "example": "<el-form :model=\"form\"></el-form>",
    "docUrl": "https://element.eleme.io/#/zh-CN/component/form",
    "props": [
      {
        "name": "model",
        "type": "object",
        "description": "表单数据对象",
        "defaultValue": "",
        "required": false
      },
      {
        "name": "rules",
        "type": "object",
        "description": "表单验证规则",
        "defaultValue": "",
        "required": false
      },
      {
        "name": "inline",
        "type": "boolean",
        "description": "行内表单模式",
        "defaultValue": "false",
        "required": false
      },
      {
        "name": "label-position",
        "type": "string",
        "description": "表单域标签的位置",
        "defaultValue": "right",
        "required": false,
        "options": ["left", "right", "top"]
      },
      {
        "name": "label-width",
        "type": "string",
        "description": "表单域标签的宽度",
        "defaultValue": "",
        "required": false
      }
    ],
    "events": [
      {
        "name": "validate",
        "description": "任一表单项被校验后触发",
        "parameters": "prop, isValid, message"
      }
    ],
    "slots": [
      {
        "name": "default",
        "description": "表单内容"
      }
    ]
  },
  {
    "name": "el-select",
    "description": "选择器组件，支持单选和多选。",
    "version": "Element UI >=2.0.0",
    "example": "<el-select v-model=\"value\" placeholder=\"请选择\"></el-select>",
    "docUrl": "https://element.eleme.io/#/zh-CN/component/select",
    "props": [
      {
        "name": "value",
        "type": "string|number|boolean|object",
        "description": "绑定值",
        "defaultValue": "",
        "required": false
      },
      {
        "name": "multiple",
        "type": "boolean",
        "description": "是否多选",
        "defaultValue": "false",
        "required": false
      },
      {
        "name": "disabled",
        "type": "boolean",
        "description": "是否禁用",
        "defaultValue": "false",
        "required": false
      },
      {
        "name": "size",
        "type": "string",
        "description": "输入框尺寸",
        "defaultValue": "medium",
        "required": false,
        "options": ["medium", "small", "mini"]
      },
      {
        "name": "clearable",
        "type": "boolean",
        "description": "是否可以清空选项",
        "defaultValue": "false",
        "required": false
      },
      {
        "name": "placeholder",
        "type": "string",
        "description": "占位符",
        "defaultValue": "请选择",
        "required": false
      },
      {
        "name": "filterable",
        "type": "boolean",
        "description": "是否可搜索",
        "defaultValue": "false",
        "required": false
      }
    ],
    "events": [
      {
        "name": "change",
        "description": "选中值发生变化时触发",
        "parameters": "value"
      },
      {
        "name": "visible-change",
        "description": "下拉框出现/隐藏时触发",
        "parameters": "visible"
      },
      {
        "name": "remove-tag",
        "description": "多选模式下移除tag时触发",
        "parameters": "value"
      },
      {
        "name": "clear",
        "description": "可清空的单选模式下用户点击清空按钮时触发",
        "parameters": ""
      },
      {
        "name": "blur",
        "description": "当 input 失去焦点时触发",
        "parameters": "event"
      },
      {
        "name": "focus",
        "description": "当 input 获得焦点时触发",
        "parameters": "event"
      }
    ],
    "slots": [
      {
        "name": "default",
        "description": "Option 组件列表"
      },
      {
        "name": "prefix",
        "description": "Select 组件头部内容"
      }
    ]
  }
]