[
  {
    "name": "a-button",
    "description": "按钮组件，支持多种类型和尺寸。",
    "version": "Ant Design Vue >=2.0.0",
    "example": "<a-button type=\"primary\">主要按钮</a-button>",
    "docUrl": "https://antdv.com/components/button",
    "props": [
      {
        "name": "type",
        "type": "string",
        "description": "按钮类型",
        "defaultValue": "default",
        "required": false,
        "options": ["primary", "ghost", "dashed", "link", "text", "default"]
      },
      {
        "name": "size",
        "type": "string",
        "description": "按钮尺寸",
        "defaultValue": "middle",
        "required": false,
        "options": ["large", "middle", "small"]
      },
      {
        "name": "disabled",
        "type": "boolean",
        "description": "是否禁用按钮",
        "defaultValue": "false",
        "required": false
      },
      {
        "name": "loading",
        "type": "boolean",
        "description": "是否显示加载状态",
        "defaultValue": "false",
        "required": false
      },
      {
        "name": "shape",
        "type": "string",
        "description": "按钮形状",
        "defaultValue": "default",
        "required": false,
        "options": ["default", "circle", "round"]
      },
      {
        "name": "block",
        "type": "boolean",
        "description": "是否将按钮宽度调整为其父宽度的100%",
        "defaultValue": "false",
        "required": false
      }
    ],
    "events": [
      {
        "name": "click",
        "description": "点击按钮时触发",
        "parameters": "event"
      }
    ],
    "slots": [
      {
        "name": "default",
        "description": "按钮内容"
      },
      {
        "name": "icon",
        "description": "按钮图标"
      }
    ]
  },
  {
    "name": "a-input",
    "description": "输入框组件，支持多种类型和校验。",
    "version": "Ant Design Vue >=2.0.0",
    "example": "<a-input v-model:value=\"inputValue\" />",
    "docUrl": "https://antdv.com/components/input",
    "props": [
      {
        "name": "value",
        "type": "string",
        "description": "绑定值",
        "defaultValue": "",
        "required": false
      },
      {
        "name": "type",
        "type": "string",
        "description": "输入框类型",
        "defaultValue": "text",
        "required": false,
        "options": ["text", "textarea", "password", "number", "email", "url", "tel"]
      },
      {
        "name": "placeholder",
        "type": "string",
        "description": "占位符",
        "defaultValue": "",
        "required": false
      },
      {
        "name": "disabled",
        "type": "boolean",
        "description": "是否禁用",
        "defaultValue": "false",
        "required": false
      },
      {
        "name": "size",
        "type": "string",
        "description": "输入框尺寸",
        "defaultValue": "middle",
        "required": false,
        "options": ["large", "middle", "small"]
      },
      {
        "name": "allow-clear",
        "type": "boolean",
        "description": "是否可清空",
        "defaultValue": "false",
        "required": false
      }
    ],
    "events": [
      {
        "name": "input",
        "description": "在输入值改变时触发",
        "parameters": "value"
      },
      {
        "name": "change",
        "description": "在值改变时触发",
        "parameters": "value"
      },
      {
        "name": "blur",
        "description": "在 Input 失去焦点时触发",
        "parameters": "event"
      },
      {
        "name": "focus",
        "description": "在 Input 获得焦点时触发",
        "parameters": "event"
      }
    ],
    "slots": [
      {
        "name": "default",
        "description": "输入框内容"
      },
      {
        "name": "addonBefore",
        "description": "输入框头部内容"
      },
      {
        "name": "addonAfter",
        "description": "输入框尾部内容"
      },
      {
        "name": "prefix",
        "description": "输入框前缀图标"
      },
      {
        "name": "suffix",
        "description": "输入框后缀图标"
      }
    ]
  },
  {
    "name": "a-table",
    "description": "表格组件，支持排序、筛选、分页等功能。",
    "version": "Ant Design Vue >=2.0.0",
    "example": "<a-table :columns=\"columns\" :data-source=\"data\" />",
    "docUrl": "https://antdv.com/components/table",
    "props": [
      {
        "name": "columns",
        "type": "array",
        "description": "表格列的配置描述",
        "defaultValue": "[]",
        "required": false
      },
      {
        "name": "data-source",
        "type": "array",
        "description": "数据数组",
        "defaultValue": "[]",
        "required": false
      },
      {
        "name": "pagination",
        "type": "object|boolean",
        "description": "分页器配置",
        "defaultValue": "",
        "required": false
      },
      {
        "name": "row-key",
        "type": "string|function",
        "description": "表格行 key 的取值",
        "defaultValue": "key",
        "required": false
      },
      {
        "name": "size",
        "type": "string",
        "description": "表格大小",
        "defaultValue": "default",
        "required": false,
        "options": ["large", "middle", "small"]
      },
      {
        "name": "bordered",
        "type": "boolean",
        "description": "是否展示外边框和列边框",
        "defaultValue": "false",
        "required": false
      },
      {
        "name": "scroll",
        "type": "object",
        "description": "设置横向或纵向滚动，也可用于指定滚动区域的宽和高",
        "defaultValue": "",
        "required": false
      }
    ],
    "events": [
      {
        "name": "change",
        "description": "分页、排序、筛选变化时触发",
        "parameters": "pagination, filters, sorter"
      },
      {
        "name": "expand",
        "description": "展开/收起行时触发",
        "parameters": "expanded, record"
      },
      {
        "name": "expandedRowsChange",
        "description": "展开的行变化时触发",
        "parameters": "expandedRows"
      }
    ],
    "slots": [
      {
        "name": "default",
        "description": "表格内容"
      },
      {
        "name": "bodyCell",
        "description": "自定义单元格"
      },
      {
        "name": "headerCell",
        "description": "自定义表头单元格"
      },
      {
        "name": "empty",
        "description": "空数据时显示的内容"
      }
    ]
  },
  {
    "name": "a-form",
    "description": "表单组件，用于数据录入和校验。",
    "version": "Ant Design Vue >=2.0.0",
    "example": "<a-form :model=\"form\"></a-form>",
    "docUrl": "https://antdv.com/components/form",
    "props": [
      {
        "name": "model",
        "type": "object",
        "description": "表单数据对象",
        "defaultValue": "",
        "required": false
      },
      {
        "name": "rules",
        "type": "object",
        "description": "表单验证规则",
        "defaultValue": "",
        "required": false
      },
      {
        "name": "layout",
        "type": "string",
        "description": "表单布局",
        "defaultValue": "horizontal",
        "required": false,
        "options": ["horizontal", "vertical", "inline"]
      },
      {
        "name": "label-col",
        "type": "object",
        "description": "label 标签的 Col 组件属性",
        "defaultValue": "",
        "required": false
      },
      {
        "name": "wrapper-col",
        "type": "object",
        "description": "需要为输入控件设置布局样式时，使用该属性",
        "defaultValue": "",
        "required": false
      },
      {
        "name": "size",
        "type": "string",
        "description": "设置表单组件尺寸",
        "defaultValue": "default",
        "required": false,
        "options": ["large", "middle", "small"]
      },
      {
        "name": "hide-required-mark",
        "type": "boolean",
        "description": "隐藏所有表单项的必选标记",
        "defaultValue": "false",
        "required": false
      }
    ],
    "events": [
      {
        "name": "validate",
        "description": "任一表单项被校验后触发",
        "parameters": "prop, isValid, message"
      },
      {
        "name": "submit",
        "description": "表单提交时触发",
        "parameters": ""
      }
    ],
    "slots": [
      {
        "name": "default",
        "description": "表单内容"
      }
    ]
  },
  {
    "name": "a-select",
    "description": "下拉选择器组件，支持单选和多选。",
    "version": "Ant Design Vue >=2.0.0",
    "example": "<a-select v-model:value=\"selectValue\"></a-select>",
    "docUrl": "https://antdv.com/components/select",
    "props": [
      {
        "name": "value",
        "type": "string|number|array",
        "description": "绑定值",
        "defaultValue": "",
        "required": false
      },
      {
        "name": "mode",
        "type": "string",
        "description": "设置 Select 的模式",
        "defaultValue": "default",
        "required": false,
        "options": ["multiple", "tags", "combobox"]
      },
      {
        "name": "disabled",
        "type": "boolean",
        "description": "是否禁用",
        "defaultValue": "false",
        "required": false
      },
      {
        "name": "size",
        "type": "string",
        "description": "选择框大小",
        "defaultValue": "middle",
        "required": false,
        "options": ["large", "middle", "small"]
      },
      {
        "name": "placeholder",
        "type": "string",
        "description": "占位符",
        "defaultValue": "请选择",
        "required": false
      },
      {
        "name": "allow-clear",
        "type": "boolean",
        "description": "是否可清空",
        "defaultValue": "false",
        "required": false
      },
      {
        "name": "filterable",
        "type": "boolean",
        "description": "是否可搜索",
        "defaultValue": "false",
        "required": false
      },
      {
        "name": "loading",
        "type": "boolean",
        "description": "是否显示加载状态",
        "defaultValue": "false",
        "required": false
      }
    ],
    "events": [
      {
        "name": "change",
        "description": "选中值发生变化时触发",
        "parameters": "value"
      },
      {
        "name": "blur",
        "description": "失去焦点时触发",
        "parameters": "event"
      },
      {
        "name": "focus",
        "description": "获得焦点时触发",
        "parameters": "event"
      },
      {
        "name": "dropdown-visible-change",
        "description": "下拉框展开/收起时触发",
        "parameters": "visible"
      }
    ],
    "slots": [
      {
        "name": "default",
        "description": "Option 组件列表"
      },
      {
        "name": "placeholder",
        "description": "自定义占位符"
      },
      {
        "name": "suffix-icon",
        "description": "自定义后缀图标"
      },
      {
        "name": "clear-icon",
        "description": "自定义清除图标"
      }
    ]
  },
