[
  {
    "name": "a-button",
    "description": "按钮组件，用于开始一个即时操作",
    "props": [
      {
        "name": "type",
        "description": "按钮类型",
        "type": "string",
        "options": ["primary", "ghost", "dashed", "link", "text", "default"],
        "defaultValue": "default"
      },
      {
        "name": "size",
        "description": "按钮大小",
        "type": "string",
        "options": ["large", "middle", "small"],
        "defaultValue": "middle"
      },
      {
        "name": "disabled",
        "description": "按钮是否禁用",
        "type": "boolean",
        "options": null,
        "defaultValue": false
      },
      {
        "name": "loading",
        "description": "设置按钮载入状态",
        "type": "boolean | { delay: number }",
        "options": null,
        "defaultValue": false
      },
      {
        "name": "shape",
        "description": "按钮形状",
        "type": "string",
        "options": ["default", "circle", "round"],
        "defaultValue": "default"
      }
    ],
    "events": [
      {
        "name": "click",
        "description": "点击按钮时的回调",
        "parameters": "(event: MouseEvent)"
      }
    ],
    "slots": [
      {
        "name": "default",
        "description": "按钮内容",
        "scope": null
      },
      {
        "name": "icon",
        "description": "按钮图标",
        "scope": null
      }
    ]
  },
  {
    "name": "a-input",
    "description": "输入框组件，用于用户输入",
    "props": [
      {
        "name": "value",
        "description": "输入框内容",
        "type": "string",
        "options": null,
        "defaultValue": null
      },
      {
        "name": "placeholder",
        "description": "输入框占位文本",
        "type": "string",
        "options": null,
        "defaultValue": null
      },
      {
        "name": "disabled",
        "description": "是否禁用输入框",
        "type": "boolean",
        "options": null,
        "defaultValue": false
      },
      {
        "name": "size",
        "description": "输入框大小",
        "type": "string",
        "options": ["large", "middle", "small"],
        "defaultValue": "middle"
      },
      {
        "name": "allowClear",
        "description": "是否显示清除按钮",
        "type": "boolean",
        "options": null,
        "defaultValue": false
      }
    ],
    "events": [
      {
        "name": "change",
        "description": "输入框内容变化时的回调",
        "parameters": "(event: Event)"
      },
      {
        "name": "pressEnter",
        "description": "按下回车键时的回调",
        "parameters": "(event: Event)"
      },
      {
        "name": "focus",
        "description": "输入框获得焦点时的回调",
        "parameters": "(event: FocusEvent)"
      },
      {
        "name": "blur",
        "description": "输入框失去焦点时的回调",
        "parameters": "(event: FocusEvent)"
      }
    ],
    "slots": [
      {
        "name": "default",
        "description": "输入框内容",
        "scope": null
      },
      {
        "name": "addonBefore",
        "description": "前置标签",
        "scope": null
      },
      {
        "name": "addonAfter",
        "description": "后置标签",
        "scope": null
      },
      {
        "name": "prefix",
        "description": "前缀图标",
        "scope": null
      },
      {
        "name": "suffix",
        "description": "后缀图标",
        "scope": null
      }
    ]
  },
  {
    "name": "a-table",
    "description": "表格组件，用于展示多条结构类似的数据",
    "props": [
      {
        "name": "dataSource",
        "description": "数据数组",
        "type": "array",
        "options": null,
        "defaultValue": []
      },
      {
        "name": "columns",
        "description": "表格列的配置描述",
        "type": "array",
        "options": null,
        "defaultValue": []
      },
      {
        "name": "pagination",
        "description": "分页器配置",
        "type": "object | false",
        "options": null,
        "defaultValue": null
      },
      {
        "name": "loading",
        "description": "页面是否加载中",
        "type": "boolean | object",
        "options": null,
        "defaultValue": false
      },
      {
        "name": "rowKey",
        "description": "表格行 key 的取值",
        "type": "string | function(record): string",
        "options": null,
        "defaultValue": "key"
      }
    ],
    "events": [
      {
        "name": "change",
        "description": "分页、排序、筛选变化时触发",
        "parameters": "(pagination, filters, sorter, extra: { currentDataSource: [] })"
      },
      {
        "name": "expand",
        "description": "展开的行发生变化时触发",
        "parameters": "(expanded, record)"
      },
      {
        "name": "expandedRowsChange",
        "description": "展开的行发生变化时触发",
        "parameters": "(expandedRows)"
      }
    ],
    "slots": [
      {
        "name": "default",
        "description": "表格内容",
        "scope": null
      },
      {
        "name": "headerCell",
        "description": "自定义表头单元格",
        "scope": "{ column, title, key }"
      },
      {
        "name": "bodyCell",
        "description": "自定义表格单元格",
        "scope": "{ column, text, record, index }"
      },
      {
        "name": "expandedRowRender",
        "description": "自定义展开行内容",
        "scope": "{ record, index, indent, expanded }"
      }
    ]
  },
  {
    "name": "a-form",
    "description": "表单组件，用于数据录入、校验",
    "props": [
      {
        "name": "model",
        "description": "表单数据对象",
        "type": "object",
        "options": null,
        "defaultValue": {}
      },
      {
        "name": "layout",
        "description": "表单布局",
        "type": "string",
        "options": ["horizontal", "vertical", "inline"],
        "defaultValue": "horizontal"
      },
      {
        "name": "labelCol",
        "description": "label 标签的 Col 配置",
        "type": "object",
        "options": null,
        "defaultValue": null
      },
      {
        "name": "wrapperCol",
        "description": "需要为输入控件设置布局样式时，使用该属性",
        "type": "object",
        "options": null,
        "defaultValue": null
      },
      {
        "name": "labelAlign",
        "description": "label 标签的文本对齐方式",
        "type": "string",
        "options": ["left", "right"],
        "defaultValue": "right"
      }
    ],
    "events": [
      {
        "name": "finish",
        "description": "提交表单且数据验证成功后回调",
        "parameters": "(values)"
      },
      {
        "name": "finishFailed",
        "description": "提交表单且数据验证失败后回调",
        "parameters": "({ values, errorFields, outOfDate })"
      },
      {
        "name": "valuesChange",
        "description": "字段值更新时触发",
        "parameters": "(changedValues, allValues)"
      }
    ],
    "slots": [
      {
        "name": "default",
        "description": "表单内容",
        "scope": null
      }
    ]
  },
  {
    "name": "a-select",
    "description": "下拉选择器组件",
    "props": [
      {
        "name": "value",
        "description": "当前选中的 option 的 value 值",
        "type": "string | number | array",
        "options": null,
        "defaultValue": null
      },
      {
        "name": "options",
        "description": "数据化配置选项内容",
        "type": "array",
        "options": null,
        "defaultValue": []
      },
      {
        "name": "placeholder",
        "description": "选择框默认文字",
        "type": "string",
        "options": null,
        "defaultValue": "请选择"
      },
      {
        "name": "disabled",
        "description": "是否禁用",
        "type": "boolean",
        "options": null,
        "defaultValue": false
      },
      {
        "name": "mode",
        "description": "设置 Select 的模式",
        "type": "string",
        "options": ["multiple", "tags", "combobox"],
        "defaultValue": null
      },
      {
        "name": "size",
        "description": "选择框大小",
        "type": "string",
        "options": ["large", "middle", "small"],
        "defaultValue": "middle"
      }
    ],
    "events": [
      {
        "name": "change",
        "description": "选中 option，或 input 的 value 变化时，调用此函数",
        "parameters": "(value, option)"
      },
      {
        "name": "blur",
        "description": "失去焦点的时调用",
        "parameters": "(event)"
      },
      {
        "name": "focus",
        "description": "获得焦点时调用",
        "parameters": "(event)"
      },
      {
        "name": "dropdownVisibleChange",
        "description": "展开下拉菜单的回调",
        "parameters": "(open)"
      }
    ],
    "slots": [
      {
        "name": "default",
        "description": "选择器的选项",
        "scope": null
      },
      {
        "name": "placeholder",
        "description": "自定义的选择框默认文字",
        "scope": null
      },
      {
        "name": "suffixIcon",
        "description": "自定义的选择框后缀图标",
        "scope": null
      },
      {
        "name": "clearIcon",
        "description": "自定义的多选框清除图标",
        "scope": null
      },
      {
        "name": "removeIcon",
        "description": "自定义的多选框移除图标",
        "scope": null
      },
      {
        "name": "menuItemSelectedIcon",
        "description": "自定义的多选框当前选中项图标",
        "scope": null
      }
    ]
  },
  {
    "name": "a-modal",
    "description": "模态对话框组件",
    "props": [
      {
        "name": "visible",
        "description": "对话框是否可见",
        "type": "boolean",
        "options": null,
        "defaultValue": false
      },
      {
        "name": "title",
        "description": "标题",
        "type": "string | slot",
        "options": null,
        "defaultValue": null
      },
      {
        "name": "width",
        "description": "宽度",
        "type": "string | number",
        "options": null,
        "defaultValue": 520
      },
      {
        "name": "centered",
        "description": "垂直居中展示 Modal",
        "type": "boolean",
        "options": null,
        "defaultValue": false
      },
      {
        "name": "closable",
        "description": "是否显示右上角的关闭按钮",
        "type": "boolean",
        "options": null,
        "defaultValue": true
      },
      {
        "name": "maskClosable",
        "description": "点击蒙层是否允许关闭",
        "type": "boolean",
        "options": null,
        "defaultValue": true
      },
      {
        "name": "confirmLoading",
        "description": "确定按钮 loading",
        "type": "boolean",
        "options": null,
        "defaultValue": false
      }
    ],
    "events": [
      {
        "name": "ok",
        "description": "点击确定回调",
        "parameters": "(e)"
      },
      {
        "name": "cancel",
        "description": "点击遮罩层或右上角叉或取消按钮的回调",
        "parameters": "(e)"
      },
      {
        "name": "afterClose",
        "description": "Modal 完全关闭后的回调",
        "parameters": "()"
      }
    ],
    "slots": [
      {
        "name": "default",
        "description": "Modal 的内容",
        "scope": null
      },
      {
        "name": "title",
        "description": "标题内容",
        "scope": null
      },
      {
        "name": "footer",
        "description": "底部内容",
        "scope": null
      },
      {
        "name": "closeIcon",
        "description": "自定义关闭图标",
        "scope": null
      }
    ]
  }
] 