[
  {
    "name": "a-button",
    "description": "按钮组件，支持多种样式和状态。",
    "version": "Ant Design Vue >=3.0.0",
    "example": "<a-button type=\"primary\">主要按钮</a-button>",
    "docUrl": "https://antdv.com/components/button",
    "props": [
      {
        "name": "type",
        "type": "string",
        "description": "按钮类型",
        "defaultValue": "default",
        "required": false,
        "options": ["primary", "ghost", "dashed", "link", "text", "default"]
      },
      {
        "name": "size",
        "type": "string",
        "description": "按钮尺寸",
        "defaultValue": "middle",
        "required": false,
        "options": ["large", "middle", "small"]
      },
      {
        "name": "disabled",
        "type": "boolean",
        "description": "是否禁用按钮",
        "defaultValue": "false",
        "required": false
      },
      {
        "name": "loading",
        "type": "boolean",
        "description": "是否显示加载状态",
        "defaultValue": "false",
        "required": false
      }
    ],
    "events": [
      {
        "name": "click",
        "description": "点击按钮时触发",
        "parameters": "event"
      }
    ],
    "slots": [
      {
        "name": "default",
        "description": "按钮内容"
      },
      {
        "name": "icon",
        "description": "按钮图标"
      }
    ]
  }
] 