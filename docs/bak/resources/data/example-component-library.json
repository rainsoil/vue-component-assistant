    "docUrl": "https://your-docs.com/my-modal"
  },
  {
    "name": "my-select",
    "description": "自定义下拉选择器组件",
    "version": "1.0.0",
    "example": "<my-select v-model=\"value\" :options=\"options\" />",
    "docUrl": "https://your-docs.com/my-select"
  },
  {
    "name": "my-date-picker",
    "description": "自定义日期选择器组件",
