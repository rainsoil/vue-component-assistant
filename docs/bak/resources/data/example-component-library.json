    "docUrl": "https://your-docs.com/my-button"
  },
  {
    "name": "my-input",
    "description": "自定义输入框组件，支持验证和格式化",
    "version": "1.0.0",
    "example": "<my-input v-model=\"value\" placeholder=\"请输入内容\" />",
    "docUrl": "https://your-docs.com/my-input"
  },
  {
    "name": "my-table",
    "description": "自定义表格组件，支持排序和分页",
    "version": "1.0.0",
    "example": "<my-table :data=\"tableData\" :columns=\"columns\" />",
    "docUrl": "https://your-docs.com/my-table"
  },
  {
    "name": "my-modal",
    "description": "自定义模态框组件",
    "version": "1.0.0",
